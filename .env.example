# ALERTA360 Environment Variables

# API Configuration
# Vacío = rutas relativas `/api` (proxy de Vite en desarrollo, nginx en producción).
# Solo hace falta si el backend vive en otro dominio:
# VITE_API_URL=https://api.ejemplo.com/api
VITE_API_TIMEOUT=10000

# Map Settings
VITE_MAP_DEFAULT_ZOOM=3
VITE_MAP_DEFAULT_CENTER_LAT=0
VITE_MAP_DEFAULT_CENTER_LNG=0

# Data Sources
VITE_USGS_ENABLED=true
VITE_NOAA_ENABLED=true
VITE_EONET_ENABLED=true
VITE_NASA_ENABLED=true

# Update Intervals (in milliseconds)
# 2 minutos: cumple el criterio de latencia < 2 min de la Fase 1.
VITE_UPDATE_INTERVAL=120000

# Notifications
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_SOUND_ENABLED=true
