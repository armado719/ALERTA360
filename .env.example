# ALERTA360 Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Map Settings
VITE_MAP_DEFAULT_ZOOM=3
VITE_MAP_DEFAULT_CENTER_LAT=0
VITE_MAP_DEFAULT_CENTER_LNG=0

# Data Sources
VITE_USGS_ENABLED=true
VITE_NOAA_ENABLED=true
VITE_NASA_ENABLED=true

# Update Intervals (in milliseconds)
VITE_UPDATE_INTERVAL=300000

# Notifications
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_SOUND_ENABLED=true
