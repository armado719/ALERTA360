# Database
DATABASE_URL="postgresql://alerta360:alerta360_dev_password@localhost:5432/alerta360"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
# Orígenes permitidos separados por comas.
# En desarrollo se acepta cualquier localhost/127.0.0.1 con cualquier puerto
# (Vite cambia a 5174 si 5173 está ocupado) y las IP de la red local.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Data Sources
USGS_ENABLED=true
NOAA_ENABLED=true

# Update Intervals (in milliseconds)
# 2 minutos: cumple el criterio de latencia < 2 min de la Fase 1.
INGEST_INTERVAL=120000

# Fuentes de eventos (todas gratuitas, sin clave)
EONET_ENABLED=true
# Vacío = cobertura mundial. Formato: minLon,minLat,maxLon,maxLat
EONET_BBOX=
EONET_DAYS=30
GDACS_ENABLED=true
GDACS_DAYS=30
# Conos de pronóstico del NHC (ciclones tropicales del Atlántico y el Pacífico)
NHC_ENABLED=true
NHC_URL=https://mapservices.weather.noaa.gov/tropical/rest/services/tropical/NHC_tropical_weather_summary/MapServer/7/query
NHC_TIMEOUT=10000

# IDEAM (lluvia diaria, Colombia)
IDEAM_ENABLED=false
IDEAM_RAIN_URL=https://www.datos.gov.co/resource/s54a-sgyg.json
IDEAM_RAIN_MIN_MM=50
IDEAM_TIMEOUT=30000

# IDEAM OSPA (amenaza por deslizamientos, Colombia). Nivel mínimo: BAJA, MODERADA o ALTA
IDEAM_LANDSLIDE_ENABLED=false
IDEAM_LANDSLIDE_URL=https://bart.ideam.gov.co/ospa/Alertas/modelos/deslizamientos/ultimo/amenaza_idd.csv
IDEAM_LANDSLIDE_MIN_LEVEL=MODERADA
IDEAM_LANDSLIDE_TIMEOUT=60000

# Búsqueda de lugares (Nominatim / OpenStreetMap)
GEOCODE_ENABLED=true

NOMINATIM_URL=https://nominatim.openstreetmap.org

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDGRID_API_KEY=

# Entrega de notificaciones (opcional en desarrollo)
EMAIL_FROM=alertas@alerta360.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Documentación en /docs y /openapi.json
DOCS_ENABLED=true
