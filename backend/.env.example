# Database
DATABASE_URL="postgresql://alerta360:alerta360_dev_password@localhost:5432/alerta360"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Data Sources
USGS_ENABLED=true
NOAA_ENABLED=true
NASA_ENABLED=true

# Update Intervals (in milliseconds)
INGEST_INTERVAL=300000

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDGRID_API_KEY=
EOF