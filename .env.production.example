# ALERTA360 — variables de PRODUCCIÓN
# Copiar a .env.produccion y completar. NO subir ese archivo al repositorio.

# --- Base de datos ---
DB_USER=alerta360
DB_PASSWORD=cambia-esta-clave
DB_NAME=alerta360
BACKUP_RETENTION_DAYS=7

# --- Backend ---
JWT_SECRET=genera-con-openssl-rand-hex-32
# Lista separada por comas. Incluye siempre www si lo usas:
# con una sola entrada, el navegador bloquea el otro dominio (error CORS).
CORS_ORIGIN=https://alerta360.com,https://www.alerta360.com
USGS_ENABLED=true
NOAA_ENABLED=true
INGEST_INTERVAL=300000

# --- Dominio / TLS ---
DOMAIN=alerta360.com

# --- Despliegue ---
IMAGE_TAG=latest

# --- Observabilidad ---
GRAFANA_PASSWORD=cambia-esta-clave
GRAFANA_ROOT_URL=https://alerta360.com/grafana/
# Webhook de Alertmanager (Slack, Discord, Telegram…). Vacío = alertas sin envío.
ALERT_WEBHOOK_URL=
