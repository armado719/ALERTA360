# ALERTA360 — variables de PRODUCCIÓN
# Copiar a .env.production y completar. NO subir ese archivo al repositorio.

# --- Base de datos ---
DB_USER=alerta360
DB_PASSWORD=cambia-esta-clave
DB_NAME=alerta360
BACKUP_RETENTION_DAYS=7

# --- Backend ---
JWT_SECRET=genera-con-openssl-rand-hex-32
# Lista separada por comas. Incluye siempre www si lo usas:
# con una sola entrada, el navegador bloquea el otro dominio (error CORS).
CORS_ORIGIN=https://alerta360.com,https://www.alerta360.com
USGS_ENABLED=true
NOAA_ENABLED=true
INGEST_INTERVAL=120000

# --- Fuentes de eventos (todas gratuitas, sin clave) ---
# Vacío = cobertura mundial. Formato: minLon,minLat,maxLon,maxLat
EONET_ENABLED=true
EONET_BBOX=
EONET_DAYS=30
GDACS_ENABLED=true
GDACS_DAYS=30
# Conos de pronóstico del NHC (ciclones tropicales del Atlántico y el Pacífico)
NHC_ENABLED=true
NHC_URL=https://mapservices.weather.noaa.gov/tropical/rest/services/tropical/NHC_tropical_weather_summary/MapServer/7/query
NHC_TIMEOUT=10000

# IDEAM (lluvia diaria, Colombia)
IDEAM_ENABLED=false
IDEAM_RAIN_URL=https://www.datos.gov.co/resource/s54a-sgyg.json
IDEAM_RAIN_MIN_MM=50
IDEAM_TIMEOUT=30000

# IDEAM OSPA (amenaza por deslizamientos, Colombia). Nivel mínimo: BAJA, MODERADA o ALTA
IDEAM_LANDSLIDE_ENABLED=false
IDEAM_LANDSLIDE_URL=https://bart.ideam.gov.co/ospa/Alertas/modelos/deslizamientos/ultimo/amenaza_idd.csv
IDEAM_LANDSLIDE_MIN_LEVEL=MODERADA
IDEAM_LANDSLIDE_TIMEOUT=60000

# --- Geocodificación (búsqueda de lugares) ---
GEOCODE_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Dominio / TLS ---
DOMAIN=alerta360.com

# --- Despliegue ---
IMAGE_TAG=latest

# --- Entrega de alertas (email y SMS) ---
# Sin estas claves el motor sigue funcionando: la notificación queda en
# `skipped` y se ve en la bandeja, pero no sale del sistema.
SENDGRID_API_KEY=
EMAIL_FROM=alertas@alerta360.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Documentación ---
# false = no publicar /docs ni /openapi.json
DOCS_ENABLED=true

# --- Observabilidad ---
GRAFANA_PASSWORD=cambia-esta-clave
GRAFANA_ROOT_URL=https://alerta360.com/grafana/
# Webhook de Alertmanager (Slack, Discord, Telegram…). Vacío = alertas sin envío.
ALERT_WEBHOOK_URL=
