+      {children}
+      {badge !== undefined && (
+        <span className="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full
+                         text-[10px] font-bold text-white bg-orange-500
+                         flex items-center justify-center border-2 border-[#15202d]">
+          {badge}
+        </span>
+      )}
+    </motion.button>
+  )
+}
